# Standard: Textdateien mit einheitlichen Zeilenenden
* text=auto

# Unity-Szenen und -Dateien als Text (Unity muss auf "Force Text" stehen)
*.cs        text diff=csharp
*.shader    text
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text merge=unityyamlmerge eol=lf

# ============================================
# Binärdateien (kein Git LFS – Assets sind klein, Low-Poly)
# ============================================
# 3D-Modelle
*.fbx   binary
*.FBX   binary
*.obj   binary
*.blend binary
*.glb   binary
*.gltf  binary

# Bilder / Texturen
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.exr  binary

# Audio
*.wav binary
*.mp3 binary
*.ogg binary

# Schriften
*.ttf binary
*.otf binary

# Archive
*.zip binary
